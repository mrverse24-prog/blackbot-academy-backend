PORT=3000
NODE_ENV=production

# Database
DATABASE_URL=postgresql://postgres:password@host:5432/blackbot-academy-db

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Stripe
STRIPE_SECRET_KEY=sk_live_your_stripe_key
